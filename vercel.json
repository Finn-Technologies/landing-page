{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/reports",
      "destination": "/api/reports"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/"
    }
  ]
}
